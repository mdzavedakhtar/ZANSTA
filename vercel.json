{
  "version": 2,
  "buildCommand": "npm --workspace=client run build",
  "outputDirectory": "client/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/api",
      "destination": "/api"
    },
    {
      "source": "/robots.txt",
      "destination": "/robots.txt"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap.xml"
    },
    {
      "source": "/((?!api|favicon.svg|manifest.json|robots.txt|sitemap.xml|assets).*)",
      "destination": "/index.html"
    }
  ]
}
