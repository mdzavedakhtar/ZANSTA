# ZANSTA Environment Configuration Template

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000

# Database Configuration (MongoDB Atlas / Local)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/zansta?retryWrites=true&w=majority

# Authentication & Security
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Superadmin Credentials
SUPERADMIN_EMAIL=your_admin_email@example.com
SUPERADMIN_PASSWORD=your_secure_password_here
SUPERADMIN_NAME=Admin Name

# Email Services Configuration (Nodemailer SMTP / Gmail)
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_FROM=ZANSTA <your_email@gmail.com>
ADMIN_EMAIL=your_email@gmail.com

# GitHub OAuth Integration (Future Phase)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Cloudinary File Storage (Future Phase)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Vite Client Public Environment Variables
VITE_API_BASE_URL=http://localhost:5000/api/v1
VITE_SOCKET_URL=http://localhost:5000
VITE_APP_NAME=ZANSTA
